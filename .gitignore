# ---------------------------------------------------------------------------
# CampusConnect+ — files that must never be committed
# ---------------------------------------------------------------------------

# Database — contains real student names, emails and attendance records.
# Render builds a fresh one with init_db.py, so it is not needed in the repo.
campusconnect.db
campusconnect.db-journal
campusconnect.db-wal
campusconnect.db-shm
*.db.backup_*

# Snapshots written by verify_migration.py --save
*_baseline.txt
sqlite_baseline.txt

# Local backups taken during development
app.py.backup_*
app.working_reference_*.pyc
templates_backup_*/
*_FULL_BACKUP_*/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Secrets — never commit these. Use environment variables.
.env
.env.*
*.pem
*.key

# Generated QR images: recreated on demand, and they leak session tokens.
static/qr/*.png

# Flutter build output — ~500 MB, regenerated by `flutter build`
campusconnect_app/build/
campusconnect_app/.dart_tool/
campusconnect_app/.flutter-plugins
campusconnect_app/.flutter-plugins-dependencies
campusconnect_app/android/.gradle/
campusconnect_app/android/app/debug/
campusconnect_app/android/app/release/
campusconnect_app/ios/Pods/
*.apk
*.aab
*.ipa

# The compiled Flutter web build IS deployed, so it is intentionally NOT
# ignored: static/flutter_app/ must be committed for Render to serve /app/.

# Editor / OS
.vscode/
.idea/
*.swp
Thumbs.db
.DS_Store
desktop.ini
